{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZapLite",
  "version": "0.1.6",
  "identifier": "br.com.zaplite.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://alexandreieva.tech/zaplite/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQUJCQzhBMkE4RUU0OEYKUldTUDVJNHFpcnlySVVJN0VuV3REVDlFSVpxUFhLb1VBaGk1SlRQSHpRRG45eEQwT1ZPSEZDZkwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

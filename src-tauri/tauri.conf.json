{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZapLite",
  "version": "0.1.5",
  "identifier": "br.com.zaplite.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"],
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://alexandreieva.tech/zaplite/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxQUJCQzhBMkE4RUU0OEYKUldTUDVJNHFpcnlySVVJN0VuV3REVDlFSVpxUFhLb1VBaGk1SlRQSHpRRG45eEQwT1ZPSEZDZkwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
